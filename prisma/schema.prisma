generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum KeyTier {
  ALPHA
  BETA
}

enum KeyStatus {
  ACTIVE
  REDEEMED
  REVOKED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique // stored lowercased
  passwordHash    String
  role            Role      @default(PLAYER)
  createdAt       DateTime  @default(now())
  emailVerifiedAt DateTime?
  passwordChangedAt DateTime? // sessions issued before this are rejected

  redemptions         Redemption[]
  downloadEvents      DownloadEvent[]
  auditLogs           AuditLog[]
  mintedKeys          AccessKey[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  nativeSessions      NativeSession[]
  nativeAuthCodes     NativeAuthCode[]
  createdServers      OfficialServer[]
  joinTickets         JoinTicket[]
  serverSessions      ServerSession[]
}

model AccessKey {
  id           String    @id @default(cuid())
  codeHash     String    @unique // sha256 hex of the normalized code
  codePrefix   String // first group after TWAZ-, for admin lookup
  tier         KeyTier
  status       KeyStatus @default(ACTIVE)
  batchLabel   String
  createdById  String?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?

  redemption Redemption?

  @@index([codePrefix])
  @@index([status, tier])
}

model Redemption {
  id         String    @id @default(cuid())
  keyId      String    @unique
  key        AccessKey @relation(fields: [keyId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt DateTime  @default(now())
  ip         String?

  @@index([userId])
}

model DownloadEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifactVersion String
  issuedAt        DateTime @default(now())
  ip              String?

  @@index([userId])
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  targetId String?
  meta     Json?
  at       DateTime @default(now())

  @@index([at])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 hex
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 hex
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One-time launcher authorization code. Only the sha256 of the code is stored.
// sessionId is set in the same transaction as the code exchange. Rows stay for at least
// 24h after expiresAt so a second presentation can revoke the linked session.
model NativeAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String
  redirectUri   String
  codeChallenge String
  pwdAt         DateTime // passwordChangedAt snapshot; epoch when the user has never changed it
  expiresAt     DateTime
  usedAt        DateTime?
  sessionId     String?   @unique
  session       NativeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A refresh-token family. Access tokens are not stored; they die when this row is revoked or expired.
model NativeSession {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String
  createdAt         DateTime  @default(now())
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime
  idleExpiresAt     DateTime
  revokedAt         DateTime?
  revokeReason      String?

  authCode      NativeAuthCode?
  refreshTokens NativeRefreshToken[]
  joinTickets   JoinTicket[]

  @@index([userId])
  @@index([absoluteExpiresAt])
}

// Every issued refresh token, hashed. usedAt set means it was rotated; presenting it again revokes the family.
model NativeRefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  sessionId    String
  session      NativeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  replacedById String?   @unique

  @@index([sessionId])
}

// Fixed-window counter: one row per bucket key, reset when the window rolls over.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

enum ServerStatus {
  ACTIVE
  DISABLED
}

// An official dedicated server. Only the sha256 of its secret is stored.
// Clients may join when buildFamily AND protocolVersion match; gameBuild/serverRuntime are informational only.
model OfficialServer {
  id                String       @id @default(cuid())
  name              String
  region            String
  host              String
  port              Int
  gameBuild         String // informational; kept in sync from accepted heartbeats
  buildFamily       String
  protocolVersion   Int
  clientPlatforms   String[] // client OS builds allowed to join, e.g. win-x64, linux-x64
  status            ServerStatus @default(ACTIVE)
  secretHash        String? // null = no credential yet (created in game); provisioned only via the admin web rotate
  secretRotatedAt   DateTime?
  lastHeartbeatAt   DateTime?
  instanceNonce     String? // from the latest heartbeat; a new value means the process restarted
  reportedGameBuild String? // last heartbeat game_build, logged only
  serverRuntime     String? // last heartbeat server_runtime, never used to filter clients
  players           Int          @default(0)
  maxPlayers        Int          @default(0) // last heartbeat-reported value, recorded only
  adminMaxPlayers   Int          @default(64) // admin-set capacity (1-64), authoritative; returned in the heartbeat 200
  createdById       String?
  createdBy         User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  joinTickets JoinTicket[]
  sessions    ServerSession[]

  @@index([status, lastHeartbeatAt])
}

// Single-use, 60 s ticket minted by the site. Only the sha256 is stored.
model JoinTicket {
  id               String         @id @default(cuid())
  ticketHash       String         @unique
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nativeSessionId  String
  nativeSession    NativeSession  @relation(fields: [nativeSessionId], references: [id], onDelete: Cascade)
  serverId         String
  server           OfficialServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  gameBuild        String // informational
  buildFamily      String
  protocolVersion  Int
  clientPlatform   String
  createdAt        DateTime       @default(now())
  expiresAt        DateTime
  usedAt           DateTime?
  usedByConnection String? // "<instanceNonce>:<connectionId>" of the admitting connection

  serverSession ServerSession?

  @@index([userId])
  @@index([serverId])
  @@index([expiresAt])
}

// A player admitted to an official server. Connection identity is (serverId, instanceNonce, connectionId)
// so NGO client ids reused across server restarts never collide.
model ServerSession {
  id            String         @id @default(cuid())
  serverId      String
  server        OfficialServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId      String         @unique
  ticket        JoinTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  instanceNonce String
  connectionId  String
  admittedAt    DateTime       @default(now())
  endedAt       DateTime?
  endReason     String?

  @@unique([serverId, instanceNonce, connectionId])
  @@index([serverId, endedAt])
  @@index([userId, endedAt])
}
