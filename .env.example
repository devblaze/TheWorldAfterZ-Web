# Copy to .env (local dev) and replace every placeholder. Never commit real values.

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/twaz?schema=public"
# Used by docker-compose for the postgres container
POSTGRES_PASSWORD="change-me"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public base URL (used for auth callbacks and email links)
AUTH_URL="http://localhost:3000"
# Set to true when running behind a trusted reverse proxy
AUTH_TRUST_HOST="true"

# SMTP — leave SMTP_HOST empty to log verification links to the console instead
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TheWorldAfterZ <no-reply@example.com>"

# Download link signing — generate with: openssl rand -base64 32
DOWNLOAD_SIGNING_SECRET="change-me"

# Directory holding manifest.json and the launcher file
LAUNCHER_DIR="./deploy/launcher-example"
