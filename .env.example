# Copy to .env (local dev) and replace every placeholder. Never commit real values.

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/twaz?schema=public"
# Used by docker-compose for the postgres container
POSTGRES_PASSWORD="change-me"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Launcher access tokens (HS256). Required at server start, at least 32 bytes.
# The placeholder is intentionally too short so the process refuses to boot until it is replaced.
# Generate with: openssl rand -base64 32
LAUNCHER_TOKEN_SECRET="change-me"
# Comma-separated emails that get the ADMIN role on register/login (must still verify the email).
ADMIN_EMAILS="nikosantoniadis94@gmail.com"
# Moderation owner(s): must also be listed in ADMIN_EMAILS. Empty = nobody is owner (no fallback to ADMIN_EMAILS).
OWNER_EMAILS="nikosantoniadis94@gmail.com"
# Public base URL (used for auth callbacks and email links)
AUTH_URL="http://localhost:3000"
# Set to true when running behind a trusted reverse proxy
AUTH_TRUST_HOST="true"

# SMTP — leave SMTP_HOST empty to log verification links to the console instead
# Production: smtp.resend.com, user "resend", pass = Resend API key
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TheWorldAfterZ <noreply@ncatechsolutions.org>"

# Download link signing — generate with: openssl rand -base64 32
DOWNLOAD_SIGNING_SECRET="change-me"

# Directory holding manifest.json and the launcher file
LAUNCHER_DIR="./deploy/launcher-example"

# Optional update feed base (http(s), trailing slash required); empty keeps volume-only behavior.
# Example: https://twaz-updates.ncatechsolutions.org/
LAUNCHER_FEED_URL=""
# Writable private verified-object cache (ephemeral in Docker; app owns the default directory).
LAUNCHER_CACHE_DIR="/tmp/twaz-launcher-cache"

# Bug-report blob directory (replays + screenshots). Default /tmp/twaz-bug-reports.
# Production: set this to the host mount of Nick's Unraid share when that mount exists.
BUG_REPORT_STORAGE_DIR="/tmp/twaz-bug-reports"
# Optional override for the 90-day sweep (scripts/bug-reports-sweep.mjs)
BUG_REPORT_RETENTION_DAYS="90"
